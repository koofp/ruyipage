# # 需要成功注册的个数
BATCH_SIZE=2
# # 每次注册完等待时间
WAIT_BETWEEN=10
# # 退出火狐浏览器等待时间
FIREFOX_QUIT_WAIT=3


# # # Kookeey

# true 自动 false 手动
PROXY_MODEL=true  
# 生成代理的国家
AUTO_COUNTRY=SG   
